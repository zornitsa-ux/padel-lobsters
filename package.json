{
  "name": "padel-lobsters",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode localdev",
    "dev:prod": "vite --mode prod --host",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "lhci": "npm run build && lhci autorun",
    "measure": "node scripts/measure-load.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local | prettier --stdin-filepath database.types.ts > src/lib/database.types.ts",
    "db:types:check": "supabase gen types typescript --local | prettier --stdin-filepath database.types.ts | diff -u src/lib/database.types.ts - || (echo 'database.types.ts is stale — run npm run db:types' && exit 1)",
    "db:grants": "./scripts/dump-function-grants.sh --write",
    "db:grants:check": "./scripts/dump-function-grants.sh | diff -u supabase/expected_function_grants.txt - || (echo 'Function EXECUTE grants for anon/authenticated drifted from supabase/expected_function_grants.txt — review the diff above. If the change is intentional, run `npm run db:grants` and commit the result.' && exit 1)",
    "functions:serve": "supabase functions serve",
    "claude": "claude --strict-mcp-config --mcp-config .mcp.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.5",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-devtools": "^5.100.10",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.24.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@lhci/cli": "^0.15.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "chrome-launcher": "^0.13.4",
    "eslint": "9.39.4",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.5.0",
    "husky": "9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "16.4.0",
    "postcss": "^8.4.38",
    "prettier": "3.8.3",
    "puppeteer-core": "^24.43.1",
    "rollup-plugin-visualizer": "^5.14.0",
    "supabase": "2.109.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^5.3.1",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
